        #     ⑦ 召回触发条件 = first_parsed=0 && 总像素≥80万 对齐 main.py L1053
        #     ⑧ 完全删除 自创M23 9切片逻辑（main.py 根本没有）
        #     ⑨ 最终返回 points = REAL_PIXEL_INTEGERS [xtl,ytl,xbr,ybr] 对齐 main.py L1119
        #        （之前致命错误：传了 _box_c1000=[0-1000规范坐标] → 所有框尺寸缩小到 1/2~1/10！）】
        # ================================================================
        import re as _re
