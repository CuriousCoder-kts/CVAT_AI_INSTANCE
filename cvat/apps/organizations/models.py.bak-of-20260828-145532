class AIFunctionInstance(TimestampedModel):
    organization = models.ForeignKey(
        Organization,
        on_delete=models.CASCADE,
        related_name="ai_function_instances",
    )
    slug = models.SlugField(max_length=64, blank=False)
    name = models.CharField(max_length=128, blank=False)

    feature_kind = models.CharField(max_length=32, choices=FeatureKind.choices)
    provider = models.CharField(
        max_length=32, choices=ProviderKind.choices, default=ProviderKind.BAILIAN
    )

    is_enabled = models.BooleanField(default=True)
    is_default = models.BooleanField(default=False)

    config = EncryptedJSONField(blank=True, default=dict)

    nuclio_function_id = models.CharField(max_length=256, blank=True, default="")

    updated_by = models.ForeignKey(
        get_user_model(),
        null=True,
        blank=True,
        on_delete=models.SET_NULL,
        related_name="+",
    )
    last_used_at = models.DateTimeField(null=True, blank=True)

    class Meta:
        default_permissions = ()
        unique_together = ("organization", "slug")
        indexes = [
            models.Index(fields=["organization", "feature_kind", "is_default"]),
            models.Index(fields=["organization", "is_enabled"]),
        ]

    def __str__(self) -> str:
        return f"{self.organization.slug}/{self.slug} ({self.feature_kind})"
