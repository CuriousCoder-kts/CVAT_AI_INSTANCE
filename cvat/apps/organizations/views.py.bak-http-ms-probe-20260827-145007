class OrganizationViewSet(
    viewsets.GenericViewSet,
    mixins.RetrieveModelMixin,
    mixins.ListModelMixin,
    mixins.CreateModelMixin,
    mixins.DestroyModelMixin,
    PartialUpdateModelMixin,
):
    queryset = Organization.objects.all()
    search_fields = ("name", "owner", "slug")
    simple_filters = search_fields
    filter_fields = (*simple_filters, "id")
    lookup_fields = {"owner": "owner__username"}
    ordering_fields = list(filter_fields)
    ordering = "-id"
    http_method_names = ["get", "post", "patch", "delete", "head", "options"]
    iam_supports_organization_params = False
    iam_permission_class = OrganizationPermission

    def get_queryset(self):
        queryset = super().get_queryset()

        if self.action == "list":
            queryset = queryset.prefetch_related("owner")
            permission = OrganizationPermission.create_scope_list(self.request)
            queryset = permission.filter(queryset)
        else:
            queryset = queryset.select_related("owner")

        return queryset

    def get_serializer_class(self):
        if self.request.method in SAFE_METHODS:
            return OrganizationReadSerializer
        else:
            return OrganizationWriteSerializer

    def perform_create(self, serializer):
        extra_kwargs = {"owner": self.request.user}
        if not serializer.validated_data.get("name"):
            extra_kwargs.update({"name": serializer.validated_data["slug"]})
        serializer.save(**extra_kwargs)

    @action(detail=True, methods=["GET", "PATCH"], url_path="bailian-settings")
    def bailian_settings(self, request, pk=None):
        organization = self.get_object()
        settings_obj, _ = BailianSettings.objects.get_or_create(organization=organization)
        if request.method in SAFE_METHODS:
            serializer = BailianSettingsReadSerializer(settings_obj, context={"request": request})
            return Response(serializer.data)

        serializer = BailianSettingsWriteSerializer(
            settings_obj, data=request.data, partial=True, context={"request": request}
        )
        serializer.is_valid(raise_exception=True)
        serializer.save(updated_by=request.user)
        return Response(serializer.data)

    @extend_schema(
        operation_id="organizations_ai_function_instances_list",
        summary="List AI function instances of an organization",
        parameters=[
            OpenApiParameter(
                name="feature_kind",
                location=OpenApiParameter.QUERY,
                description="Filter by feature kind",
                required=False,
                type=str,
                enum=[v for v, _ in FeatureKind.choices],
            ),
            OpenApiParameter(
                name="provider",
                location=OpenApiParameter.QUERY,
                description="Filter by provider",
                required=False,
                type=str,
            ),
            OpenApiParameter(
                name="is_enabled",
                location=OpenApiParameter.QUERY,
                description="Filter by enabled state",
                required=False,
                type=bool,
            ),
        ],
        responses={"200": AIFunctionInstanceReadSerializer(many=True)},
    )
    @extend_schema(
        operation_id="organizations_ai_function_instances_create",
        summary="Create an AI function instance",
        request=AIFunctionInstanceWriteSerializer,
        responses={"201": AIFunctionInstanceReadSerializer},
    )
    @action(
        detail=True,
        methods=["GET", "POST"],
        url_path="ai-function-instances",
    )
    def ai_function_instances(self, request, pk=None):
        organization = self.get_object()
        if request.method in SAFE_METHODS:
            qs = AIFunctionInstance.objects.filter(organization=organization)
            feature_kind = request.query_params.get("feature_kind")
            provider = request.query_params.get("provider")
            is_enabled = request.query_params.get("is_enabled")
            if feature_kind:
                qs = qs.filter(feature_kind=feature_kind)
            if provider:
                qs = qs.filter(provider=provider)
            if is_enabled is not None:
                enabled_val = str(is_enabled).lower() in {"1", "true", "yes", "on"}
                qs = qs.filter(is_enabled=enabled_val)
            qs = qs.select_related("updated_by").order_by("-is_default", "-updated_date")
            serializer = AIFunctionInstanceReadSerializer(
                qs, many=True, context={"request": request}
            )
            return Response(serializer.data)

        serializer = AIFunctionInstanceWriteSerializer(
            data=request.data,
            context={"organization": organization, "updated_by": request.user},
        )
        serializer.is_valid(raise_exception=True)
        with transaction.atomic():
            if serializer.validated_data.get("is_default"):
                (
                    AIFunctionInstance.objects.filter(
                        organization=organization,
                        feature_kind=serializer.validated_data["feature_kind"],
                        is_default=True,
                    ).update(is_default=False)
                )
            instance = serializer.save()
        return Response(
            AIFunctionInstanceReadSerializer(instance, context={"request": request}).data,
            status=status.HTTP_201_CREATED,
        )

    @extend_schema(
        operation_id="organizations_ai_function_instances_retrieve",
        summary="Get an AI function instance",
        responses={"200": AIFunctionInstanceReadSerializer},
    )
    @extend_schema(
        operation_id="organizations_ai_function_instances_partial_update",
        summary="Update an AI function instance",
        request=AIFunctionInstanceWriteSerializer(partial=True),
        responses={"200": AIFunctionInstanceReadSerializer},
    )
    @extend_schema(
        operation_id="organizations_ai_function_instances_destroy",
        summary="Delete an AI function instance",
        responses={"204": OpenApiResponse(description="Deleted")},
    )
    @action(
        detail=True,
        methods=["GET", "PATCH", "DELETE"],
        url_path=r"ai-function-instances/(?P<instance_slug>[^/.]+)",
    )
    def ai_function_instance_detail(self, request, pk=None, instance_slug=None):
        organization = self.get_object()
        instance = get_object_or_404(
            AIFunctionInstance, organization=organization, slug=instance_slug
        )

        if request.method == "DELETE":
            instance.delete()
            return Response(status=status.HTTP_204_NO_CONTENT)

        if request.method in SAFE_METHODS:
            return Response(
                AIFunctionInstanceReadSerializer(instance, context={"request": request}).data
            )

        serializer = AIFunctionInstanceWriteSerializer(
            instance,
            data=request.data,
            partial=True,
            context={"organization": organization, "updated_by": request.user},
        )
        serializer.is_valid(raise_exception=True)
        with transaction.atomic():
            new_is_default = serializer.validated_data.get("is_default")
            if new_is_default and not instance.is_default:
                AIFunctionInstance.objects.filter(
                    organization=organization,
                    feature_kind=instance.feature_kind,
                    is_default=True,
                ).exclude(pk=instance.pk).update(is_default=False)
            instance = serializer.save()
        return Response(
            AIFunctionInstanceReadSerializer(instance, context={"request": request}).data
        )

    @extend_schema(
        operation_id="organizations_ai_function_instances_enable",
        summary="Enable an AI function instance",
        request=None,
        responses={"200": AIFunctionInstanceReadSerializer},
    )
    @action(
        detail=True,
        methods=["POST"],
        url_path=r"ai-function-instances/(?P<instance_slug>[^/.]+)/enable",
    )
    def ai_function_instance_enable(self, request, pk=None, instance_slug=None):
        organization = self.get_object()
        instance = get_object_or_404(
            AIFunctionInstance, organization=organization, slug=instance_slug
        )
        if not instance.is_enabled:
            instance.is_enabled = True
            instance.updated_by = request.user
            instance.save(update_fields=["is_enabled", "updated_by", "updated_date"])
        return Response(
            AIFunctionInstanceReadSerializer(instance, context={"request": request}).data
        )

    @extend_schema(
        operation_id="organizations_ai_function_instances_disable",
        summary="Disable an AI function instance",
        request=None,
        responses={"200": AIFunctionInstanceReadSerializer},
    )
    @action(
        detail=True,
        methods=["POST"],
        url_path=r"ai-function-instances/(?P<instance_slug>[^/.]+)/disable",
    )
    def ai_function_instance_disable(self, request, pk=None, instance_slug=None):
        organization = self.get_object()
        instance = get_object_or_404(
            AIFunctionInstance, organization=organization, slug=instance_slug
        )
        if instance.is_enabled:
            instance.is_enabled = False
