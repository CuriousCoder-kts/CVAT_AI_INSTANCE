            AIFunctionInstanceReadSerializer(instance, context={"request": request}).data
        )

    @extend_schema(
        operation_id="organizations_ai_function_instances_set_default",
        summary="Mark an AI function instance as the default for its feature kind",
        request=None,
        responses={"200": AIFunctionInstanceReadSerializer},
    )
    @action(
        detail=True,
        methods=["POST"],
        url_path=r"ai-function-instances/(?P<instance_slug>[^/.]+)/set-default",
    )
    def ai_function_instance_set_default(self, request, pk=None, instance_slug=None):
        organization = self.get_object()
        instance = get_object_or_404(
            AIFunctionInstance, organization=organization, slug=instance_slug
        )
        with transaction.atomic():
            AIFunctionInstance.objects.filter(
                organization=organization,
                feature_kind=instance.feature_kind,
                is_default=True,
            ).exclude(pk=instance.pk).update(is_default=False)
            if not instance.is_default:
                instance.is_default = True
                instance.updated_by = request.user
                instance.save(update_fields=["is_default", "updated_by", "updated_date"])
        return Response(
            AIFunctionInstanceReadSerializer(instance, context={"request": request}).data
        )

    @extend_schema(
        operation_id="organizations_create_members",
        summary="Directly create active member accounts for the organization",
        description=(
            "Create one or more user accounts with valid passwords and immediately activate them "
            "as organization members. No email invitation flow is required. "
            "Passwords are returned in the response (auto-generated if not provided) — save them securely.\n"
            "Permission rules: Owner can create members with worker/supervisor/maintainer roles; "
            "Maintainer can create members with worker/supervisor roles only."
        ),
        request=CreateMembersRequestSerializer,
        responses={
            "200": OpenApiResponse(
                description="Members created (note: partial success possible, check errors field)"
            ),
            "403": OpenApiResponse(description="Forbidden: insufficient role"),
        },
    )
    @action(
        detail=True,
        methods=["POST"],
        url_path="create-members",
    )
    def create_members(self, request, pk=None):
        organization = self.get_object()
        self.check_object_permissions(request, organization)

        current_membership = Membership.objects.filter(
            organization=organization, user=request.user, is_active=True
        ).first()
        current_role = current_membership.role if current_membership else None
        is_owner = current_role == Membership.OWNER
        is_maintainer = current_role == Membership.MAINTAINER

        if not (is_owner or is_maintainer):
            return Response(
                status=status.HTTP_403_FORBIDDEN,
                data="Only organization owner or maintainer can create member accounts directly.",
            )

        allowed_roles = {Membership.WORKER, Membership.SUPERVISOR}
        if is_owner:
            allowed_roles.add(Membership.MAINTAINER)

        members_payload = request.data.get("members", [])
        for idx, item in enumerate(members_payload):
            requested_role = item.get("role", Membership.WORKER)
            if requested_role not in allowed_roles:
                return Response(
                    status=status.HTTP_403_FORBIDDEN,
                    data=(
                        f"Member at index {idx} has role '{requested_role}' which is not allowed "
                        f"for your role '{current_role}'. Allowed roles: {sorted(allowed_roles)}."
                    ),
                )

        serializer = CreateMembersRequestSerializer(data=request.data)
        serializer.is_valid(raise_exception=True)
        results, errors = serializer.create_members(organization, request)

        return Response(
            status=status.HTTP_200_OK,
            data={
                "created_count": len(results),
                "error_count": len(errors),
                "results": CreateMemberResultSerializer(results, many=True).data,
                "errors": errors,
            },
        )


