"""Generic HTTP multipart detector for CVAT Automatic annotation.

POSTs the current frame as multipart/form-data to a configurable microservice
(e.g. ``POST http://host:8080/predict`` with ``image=@file`` plus extra fields
such as ``layout_on_box=1``), then maps JSON → CVAT lambda detector items.

This is the reusable replacement for model-specific local ONNX wiring
(CLRerNet). Detection is config-driven, not book-layout-specific.

Config keys (AIFunctionInstance.config)
--------------------------------------
api_url                 Full predict URL (required). Query string is kept as-is, e.g.
                        http://192.168.50.42:8081/predict?conf_thres=0.43&min_points=6
http_file_field         Multipart file field name (default: ``image``)
http_form_fields        Extra form fields: dict, list[{key,value}], or ``a=1&b=2``
http_query_fields       Optional extra query-string dict (merged onto api_url, does not strip it)
http_timeout_seconds    Request timeout (default 120)
http_auth_header        Optional header name for api_key (default Authorization Bearer)
local_backend / vision_backend
                        ``http`` / ``http_microservice`` / ``http_detector``
model                   ``http_detector`` (or any ``http_*``) also selects this path
output_parser_config    bbox_format: auto|xyxy|xywh
                        coordinate_system: real_pixel|normalized_0_1|canonical_1000
                        confidence_threshold_default
"""

from __future__ import annotations

import base64
import json
import math
import os
from typing import Any
from urllib.parse import urlencode, urlparse, urlunparse, parse_qsl

HTTP_BACKENDS = frozenset({
    "http",
    "http_microservice",
    "http_detector",
    "http_post",
    "generic_http",
})
HTTP_MODELS = frozenset({
    "http_detector",
    "http_microservice",
    "http_post",
    "generic_http",
})

DEFAULT_FILE_FIELD = "image"
DEFAULT_TIMEOUT = 120.0

# Used only when the instance has no labels of its own (avoids the 9-class
# traffic fallback on the HTTP path). Preset-supplied labels take precedence.
DEFAULT_HTTP_INJECT_LABELS: list[dict[str, Any]] = [
    {"name": "object", "type": "any", "attributes": []},
]

_ATTR_SKIP = frozenset({
    "label", "class", "class_name", "category", "name", "cls", "type",
    "points", "polygon", "polyline", "vertices", "coords", "box", "bbox",
    "rotated_box", "rbox", "confidence", "score", "prob", "probability",
    "mask", "mask_rle", "segmentation",
})


def cfg_is_http_microservice(cfg: dict | None) -> bool:
    if not isinstance(cfg, dict):
        return False
    backend = str(
        cfg.get("local_backend") or cfg.get("vision_backend") or ""
    ).strip().lower()
    model = str(cfg.get("model") or "").strip().lower()
    exec_mode = str(cfg.get("execution_mode") or "").strip().lower()
    api_url = str(cfg.get("api_url") or "").strip()

    if backend in HTTP_BACKENDS:
        return True
    if model in HTTP_MODELS or model.startswith("http_"):
        return True
    if cfg.get("http_form_fields") or cfg.get("http_file_field") or cfg.get("http_query_fields"):
        return True
    if exec_mode == "vision_pipeline" and api_url:
        url_l = api_url.lower()
        if "chat/completions" in url_l or "dashscope" in url_l:
            return False
        if "clrernet" in model:
            return False
        return True
    return False


def _as_fields(raw: Any) -> dict[str, str]:
    out: dict[str, str] = {}
    if raw is None:
        return out
    if isinstance(raw, dict):
        for k, v in raw.items():
            if k is None or v is None:
                continue
            key = str(k).strip()
            if not key:
                continue
            if isinstance(v, bool):
                out[key] = "1" if v else "0"
            else:
                out[key] = str(v)
        return out
    if isinstance(raw, list):
        for item in raw:
            if isinstance(item, dict):
                key = str(item.get("key") or item.get("name") or "").strip()
                if not key:
                    continue
                val = item.get("value")
                if val is None:
                    val = item.get("val")
                out[key] = "" if val is None else str(val)
            elif isinstance(item, (list, tuple)) and len(item) >= 2:
                key = str(item[0]).strip()
                if key:
                    out[key] = str(item[1])
        return out
    if isinstance(raw, str) and raw.strip():
        text = raw.strip()
        if text.startswith("{") or text.startswith("["):
            try:
                return _as_fields(json.loads(text))
            except (json.JSONDecodeError, ValueError):
                pass
        for pair in text.replace(";", "&").split("&"):
            if "=" in pair:
                k, v = pair.split("=", 1)
                k = k.strip()
                if k:
                    out[k] = v.strip()
    return out


def _guess_image_meta(data: bytes) -> tuple[str, str]:
    if data[:3] == b"\xff\xd8\xff":
        return "frame.jpg", "image/jpeg"
    if data[:8] == b"\x89PNG\r\n\x1a\n":
        return "frame.png", "image/png"
    if data[:2] == b"BM":
        return "frame.bmp", "image/bmp"
    if data[:6] in (b"GIF87a", b"GIF89a"):
        return "frame.gif", "image/gif"
    if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        return "frame.webp", "image/webp"
    return "frame.jpg", "image/jpeg"


def _decode_image_b64(image_b64: str) -> bytes:
    raw = (image_b64 or "").strip()
    if not raw:
        return b""
    if raw.startswith("data:") and "," in raw:
        raw = raw.split(",", 1)[1]
    return base64.b64decode(raw)


def _label_of(item: dict) -> str:
    for key in ("label", "class_name", "class", "category", "name", "cls"):
        v = item.get(key)
        if v is None:
            continue
        s = str(v).strip()
        if s:
            return s
    return "object"


def _score_of(item: dict) -> float:
    for key in ("confidence", "score", "prob", "probability"):
        v = item.get(key)
        if v is None:
            continue
        try:
            return max(0.0, min(1.0, float(v)))
        except (TypeError, ValueError):
            continue
    return 1.0


def _flatten_points(raw: Any) -> list[float] | None:
    if not isinstance(raw, (list, tuple)) or not raw:
        return None
    first = raw[0]
    if isinstance(first, (list, tuple)):
        flat: list[float] = []
        for pt in raw:
            if not isinstance(pt, (list, tuple)) or len(pt) < 2:
                return None
            try:
                flat.append(float(pt[0]))
                flat.append(float(pt[1]))
            except (TypeError, ValueError):
                return None
        return flat if len(flat) >= 2 else None
    try:
        nums = [float(x) for x in raw]
    except (TypeError, ValueError):
        return None
    return nums if len(nums) >= 2 else None


def _rotated_box_to_polygon(rb: Any) -> list[float] | None:
    if not isinstance(rb, (list, tuple)) or len(rb) < 5:
        return None
    try:
        cx, cy, w, h, ang = (float(rb[0]), float(rb[1]), float(rb[2]), float(rb[3]), float(rb[4]))
    except (TypeError, ValueError):
        return None
    hw, hh = w / 2.0, h / 2.0
    corners = ((-hw, -hh), (hw, -hh), (hw, hh), (-hw, hh))
    cos_a, sin_a = math.cos(ang), math.sin(ang)
    out: list[float] = []
    for x, y in corners:
        out.append(cx + x * cos_a - y * sin_a)
        out.append(cy + x * sin_a + y * cos_a)
    return out


def _looks_normalized(nums: list[float]) -> bool:
    if not nums:
        return False
    return max(abs(x) for x in nums) <= 1.5


def _scale_coords(
    nums: list[float],
    image_size: tuple[int, int],
    coordinate_system: str,
) -> list[float]:
    width, height = image_size
    system = (coordinate_system or "real_pixel").strip().lower()
    if system == "auto":
        system = "normalized_0_1" if _looks_normalized(nums) else "real_pixel"
    scaled: list[float] = []
    for i, v in enumerate(nums):
        side = width if i % 2 == 0 else height
        if system == "normalized_0_1":
            scaled.append(float(v) * float(side))
        elif system == "canonical_1000":
            scaled.append(float(v) / 1000.0 * float(side))
        else:
            scaled.append(float(v))
    return scaled


def _box4_to_xyxy(
    vals: list[float],
    image_size: tuple[int, int],
    bbox_format: str,
) -> list[float]:
    x, y, a, b = vals[0], vals[1], vals[2], vals[3]
    fmt = (bbox_format or "auto").strip().lower()
    if fmt in ("xywh", "xywh_pixel", "coco"):
        return [x, y, x + a, y + b]
    if fmt in ("xyxy", "x1y1x2y2"):
        return [x, y, a, b]
    width, height = image_size
    # auto: prefer xyxy when the 3rd/4th look like a bottom-right corner
    if a >= x and b >= y:
        return [x, y, a, b]
    if a >= 0 and b >= 0 and (x + a) <= (width * 1.05 + 1) and (y + b) <= (height * 1.05 + 1):
        return [x, y, x + a, y + b]
    return [x, y, a, b]


def _clip_xyxy(box: list[float], image_size: tuple[int, int]) -> list[float] | None:
    width, height = image_size
    xtl = max(0.0, min(box[0], box[2]))
    ytl = max(0.0, min(box[1], box[3]))
    xbr = min(float(width), max(box[0], box[2]))
    ybr = min(float(height), max(box[1], box[3]))
    if xbr <= xtl or ybr <= ytl:
        return None
    return [xtl, ytl, xbr, ybr]


def _clip_points(pts: list[float], image_size: tuple[int, int]) -> list[float]:
    width, height = image_size
    out: list[float] = []
    for i, v in enumerate(pts):
        side = width if i % 2 == 0 else height
        out.append(max(0.0, min(float(side), float(v))))
    return out


def _shape_type(item: dict, n_coords: int, preferred: str = "") -> str:
    raw = str(item.get("type") or "").strip().lower()
    aliases = {
        "rect": "rectangle",
        "bbox": "rectangle",
        "box": "rectangle",
        "bounding_box": "rectangle",
        "poly": "polygon",
        "obb": "polygon",
        "rotated_box": "polygon",
        "line": "polyline",
        "linestring": "polyline",
        "linestringz": "polyline",
        "curve": "polyline",
        "lane": "polyline",
        "keypoint": "points",
        "keypoints": "points",
        "point": "points",
        "caption": "tag",
    }
    mapped = aliases.get(raw, raw)
    if mapped in {"rectangle", "polygon", "polyline", "points", "tag", "ellipse", "mask"}:
        if mapped == "rectangle" and n_coords >= 8:
            return "polygon"
        return mapped
    pref = (preferred or "").strip().lower()
    if pref in {"polyline", "polylines"} and n_coords >= 4:
        return "polyline"
    if n_coords >= 8:
        return "polygon"
    if n_coords == 4:
        return "rectangle"
    if n_coords >= 6:
        return "polyline"
    return "points"


def _attributes_of(item: dict) -> list[dict[str, str]]:
    attrs: list[dict[str, str]] = []
    seen: set[str] = set()

    def _add(name: str, value: Any) -> None:
        key = str(name).strip()
        if not key or key in seen or key.lower() in _ATTR_SKIP:
            return
        if isinstance(value, (dict, list)):
            try:
                text = json.dumps(value, ensure_ascii=False)
            except (TypeError, ValueError):
                text = str(value)
        else:
            text = str(value)
        if len(text) > 512:
            text = text[:512]
        seen.add(key)
        attrs.append({"name": key[:64], "value": text})

    raw_attrs = item.get("attributes")
    if isinstance(raw_attrs, list):
        for a in raw_attrs:
            if isinstance(a, dict) and a.get("name"):
                _add(str(a.get("name")), a.get("value", ""))
    elif isinstance(raw_attrs, dict):
        for k, v in raw_attrs.items():
            _add(str(k), v)
    for extra_key in ("source", "parent_index", "parent", "id", "track_id", "group"):
        if extra_key in item and item[extra_key] is not None:
            _add(extra_key, item[extra_key])
    return attrs


def _collect_item_dicts(payload: Any) -> list[dict]:
    if isinstance(payload, list):
        out: list[dict] = []
        for x in payload:
            if isinstance(x, dict):
                out.append(x)
            elif isinstance(x, (list, tuple)) and len(x) >= 4:
                try:
                    out.append({
                        "label": "object",
                        "type": "rectangle",
                        "points": [float(x[0]), float(x[1]), float(x[2]), float(x[3])],
                    })
                except (TypeError, ValueError):
                    continue
        return out
    if not isinstance(payload, dict):
        return []
    for key in (
        "shapes", "objects", "annotations", "detections", "items",
        "results", "instances", "boxes", "labels", "layout", "regions",
        "lanes", "polylines", "lines", "line_strings",
    ):
        v = payload.get(key)
        if isinstance(v, list) and v:
            nested = _collect_item_dicts(v)
            if nested:
                return nested
    # single-object dict that already looks like a shape
    if any(k in payload for k in (
        "points", "box", "bbox", "polygon", "polyline", "rotated_box",
        "vertices", "coords",
    )):
        return [payload]
    return []


def parse_microservice_json(
    payload: Any,
    *,
    image_size: tuple[int, int] = (0, 0),
    parser_config: dict | None = None,
    threshold: float | None = None,
) -> list[dict[str, Any]]:
    """Convert a microservice JSON body into CVAT lambda detector items."""
    cfg = parser_config if isinstance(parser_config, dict) else {}
    if isinstance(payload, dict):
        env_w = payload.get("width")
        env_h = payload.get("height")
        try:
            if int(env_w or 0) > 0 and int(env_h or 0) > 0:
                image_size = (int(env_w), int(env_h))
        except (TypeError, ValueError):
            pass
        code = payload.get("code")
        if code not in (None, 0, "0", "ok", "success", True):
            msg = str(payload.get("message") or payload.get("error") or code)
            raise RuntimeError(f"microservice returned error code={code}: {msg[:240]}")

    width, height = image_size
    if width <= 0:
        width = 1
    if height <= 0:
        height = 1
    image_size = (width, height)

    bbox_format = str(cfg.get("bbox_format") or "auto")
    coordinate_system = str(cfg.get("coordinate_system") or "real_pixel")
    preferred_shape = str(
        cfg.get("preferred_shape_type") or cfg.get("output_format") or ""
    )
    thr = (
        float(threshold)
        if isinstance(threshold, (int, float))
        else float(cfg.get("confidence_threshold_default", 0.0) or 0.0)
    )
    thr = max(0.0, min(1.0, thr))

    items = _collect_item_dicts(payload)
    out: list[dict[str, Any]] = []
    for item in items:
        if not isinstance(item, dict):
            continue
        conf = _score_of(item)
        if conf < thr:
            continue
        label = _label_of(item)

        pts: list[float] | None = None
        pts_from: str | None = None
        for key in ("points", "polygon", "polyline", "vertices", "coords"):
            pts = _flatten_points(item.get(key))
            if pts is not None:
                pts_from = key
                break
        if pts is None:
            for key in ("box", "bbox"):
                raw_box = _flatten_points(item.get(key))
                if raw_box is not None and len(raw_box) >= 4:
                    pts = _box4_to_xyxy(raw_box, image_size, bbox_format)
                    item = {**item, "type": item.get("type") or "rectangle"}
                    pts_from = key
                    break
        if pts is None:
            rb = _rotated_box_to_polygon(item.get("rotated_box") or item.get("rbox"))
            if rb is not None:
                pts = rb
                item = {**item, "type": item.get("type") or "polygon"}
                pts_from = "rotated_box"
        if pts is None:
            continue

        if not str(item.get("type") or "").strip():
            if pts_from == "polyline":
                item = {**item, "type": "polyline"}
            elif pts_from == "polygon":
                item = {**item, "type": "polygon"}

        pts = _scale_coords(pts, image_size, coordinate_system)
        shape_type = _shape_type(item, len(pts), preferred_shape)
        if shape_type == "tag":
            out.append({
                "label": label,
                "type": "tag",
                "confidence": str(round(conf, 4)),
                "attributes": _attributes_of(item),
            })
            continue
        if shape_type == "rectangle":
            if len(pts) >= 8:
                xs = pts[0::2]
                ys = pts[1::2]
                box = _clip_xyxy([min(xs), min(ys), max(xs), max(ys)], image_size)
            elif len(pts) >= 4:
                box = _clip_xyxy(pts[:4], image_size)
            else:
                continue
            if box is None:
                continue
            points_out: list[float] = [round(v, 2) for v in box]
        else:
            if len(pts) % 2 == 1:
                pts = pts[:-1]
            min_n = 6 if shape_type == "polygon" else (4 if shape_type == "polyline" else 2)
            if len(pts) < min_n:
                continue
            points_out = [round(v, 2) for v in _clip_points(pts, image_size)]

        rec: dict[str, Any] = {
            "label": label,
            "type": shape_type,
            "points": points_out,
            "confidence": str(round(conf, 4)),
        }
        attrs = _attributes_of(item)
        if attrs:
            rec["attributes"] = attrs
        out.append(rec)
    return out


def merge_query_into_url(api_url: str, query_fields: dict[str, str] | None = None) -> str:
    """Keep any existing ``?a=b`` on ``api_url`` and merge extra query fields."""
    url = (api_url or "").strip()
    extra = query_fields or {}
    if not extra:
        return url
    parsed = urlparse(url)
    q = dict(parse_qsl(parsed.query, keep_blank_values=True))
    q.update(extra)
    return urlunparse(parsed._replace(query=urlencode(q)))


def infer_http_microservice_from_image_b64(
    image_b64: str,
    *,
    cfg: dict | None = None,
    threshold: float | None = None,
) -> list[dict[str, Any]]:
    cfg = cfg if isinstance(cfg, dict) else {}
    api_url = str(cfg.get("api_url") or "").strip()
    if not api_url:
        raise ValueError(
            "HTTP microservice detector requires config.api_url "
            "(e.g. http://192.168.50.42:8080/predict)"
        )
    image_bytes = _decode_image_b64(image_b64)
    if not image_bytes:
        raise ValueError("HTTP microservice detector received an empty image payload")

    filename, content_type = _guess_image_meta(image_bytes)
    file_field = str(cfg.get("http_file_field") or DEFAULT_FILE_FIELD).strip() or DEFAULT_FILE_FIELD
    form_fields = _as_fields(cfg.get("http_form_fields"))
    query_fields = _as_fields(cfg.get("http_query_fields"))
    try:
        timeout = float(cfg.get("http_timeout_seconds") or os.environ.get("HTTP_MS_TIMEOUT") or DEFAULT_TIMEOUT)
    except (TypeError, ValueError):
        timeout = DEFAULT_TIMEOUT
    timeout = max(5.0, min(600.0, timeout))

    url = merge_query_into_url(api_url, query_fields)

    headers: dict[str, str] = {}
    api_key = str(cfg.get("api_key") or "").strip()
    if api_key:
        header_name = str(cfg.get("http_auth_header") or "Authorization").strip() or "Authorization"
        if header_name.lower() == "authorization" and not api_key.lower().startswith("bearer "):
            headers[header_name] = f"Bearer {api_key}"
        else:
            headers[header_name] = api_key

    try:
        import requests
    except ImportError as exc:
        raise RuntimeError("requests is required to call an HTTP microservice") from exc

    files = {file_field: (filename, image_bytes, content_type)}
    try:
        resp = requests.post(
            url,
            files=files,
            data=form_fields or None,
            headers=headers or None,
            timeout=timeout,
        )
    except Exception as exc:
        raise RuntimeError(
            f"HTTP microservice POST {url} failed: {type(exc).__name__}: {str(exc)[:200]}"
        ) from exc

    if resp.status_code >= 400:
        body = (resp.text or "")[:240]
        raise RuntimeError(
            f"HTTP microservice {url} returned HTTP {resp.status_code}: {body}"
        )

    try:
        payload = resp.json()
    except ValueError:
        text = (resp.text or "").strip()
        try:
            payload = json.loads(text) if text else {}
        except (json.JSONDecodeError, ValueError) as exc:
            raise RuntimeError(
                f"HTTP microservice returned non-JSON body: {text[:200]}"
            ) from exc

    parser_cfg = dict(cfg.get("output_parser_config") or {}) if isinstance(cfg.get("output_parser_config"), dict) else {}
    if cfg.get("output_format") and "output_format" not in parser_cfg:
        parser_cfg["output_format"] = cfg.get("output_format")
    img_w, img_h = 0, 0
    try:
        from io import BytesIO
        from PIL import Image as _PILImage
        with _PILImage.open(BytesIO(image_bytes)) as im:
            im.load()
            img_w, img_h = im.size
    except Exception:
        if isinstance(payload, dict):
            try:
                img_w = int(payload.get("width") or 0)
                img_h = int(payload.get("height") or 0)
            except (TypeError, ValueError):
                img_w, img_h = 0, 0

    return parse_microservice_json(
        payload,
        image_size=(img_w, img_h),
        parser_config=parser_cfg,
        threshold=threshold,
    )
