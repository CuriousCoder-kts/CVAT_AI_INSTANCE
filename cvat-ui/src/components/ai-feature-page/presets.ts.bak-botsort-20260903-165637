/** Detector dual-head placeholders (e.g. 8082 GET /labels includes "None"). Never a CVAT label. */
const PLACEHOLDER_LABEL_NAMES = new Set([
    '', 'none', 'null', 'nil', 'n/a', 'na', 'nan', '-', 'unknown', 'nones',
]);

export function isPlaceholderLabel(name: string | null | undefined): boolean {
    return PLACEHOLDER_LABEL_NAMES.has(String(name || '').trim().toLowerCase());
}

const LABEL_NAME_RE = /^[A-Za-z_][A-Za-z0-9_-]*$/;
const LABEL_TYPES = new Set([
    'rectangle', 'polygon', 'polyline', 'points', 'ellipse', 'circle',
    'mask', 'cuboid', 'skeleton', 'tag', 'any',
]);

export interface LabelSpec {
    name: string;
    type?: 'rectangle' | 'polygon' | 'polyline' | 'points' | 'ellipse' | 'circle' | 'mask' | 'cuboid' | 'skeleton' | 'tag' | 'any';
    description?: string;
    color?: string;
    attributes?: Array<{
        name: string;
        input_type?: 'text' | 'number' | 'checkbox' | 'select' | 'radio';
        type?: string;
        values?: string[];
        default_value?: string | number | boolean;
        mutable?: boolean;
        description?: string;
    }>;
}

function replaceTrailingCommas(value: string): string {
    return value.replace(/,{1}[\s]*}/g, '}').replace(/,{1}[\s]*]/g, ']');
}

export function serializeLabelsRaw(labels: LabelSpec[] | undefined): string {
    const rows = (Array.isArray(labels) ? labels : [])
        .filter((item) => item && typeof item.name === 'string' && item.name.trim() && !isPlaceholderLabel(item.name))
        .map((item) => {
            const row: Record<string, unknown> = {
                name: String(item.name).trim(),
                type: item.type && LABEL_TYPES.has(item.type) ? item.type : 'any',
                attributes: Array.isArray(item.attributes) ? item.attributes : [],
            };
            if (item.color) row.color = item.color;
            if (item.description) row.description = item.description;
            return row;
        });
    return `${JSON.stringify(rows, null, 2)}\n`;
}

export function parseLabelsRawJson(raw: string): LabelSpec[] {
    let text = String(raw || '').trim();
    if (!text) {
        throw new Error('Paste a JSON array of labels');
    }
    if (!text.startsWith('[')) {
        text = `[${text}]`;
    }
    let parsed: unknown;
    try {
        parsed = JSON.parse(replaceTrailingCommas(text));
    } catch (error: any) {
        throw new Error(error?.message || 'Invalid JSON');
    }
    if (parsed && typeof parsed === 'object' && !Array.isArray(parsed) && Array.isArray((parsed as any).labels)) {
        parsed = (parsed as any).labels;
    }
    if (!Array.isArray(parsed)) {
        throw new Error('Field is expected to be a JSON array');
    }
    const out: LabelSpec[] = [];
    const seen = new Set<string>();
    for (const item of parsed) {
        if (!item || typeof item !== 'object') {
            throw new Error('Each label must be an object with name, type, attributes');
        }
        const name = String((item as any).name || '').trim();
        if (!name || isPlaceholderLabel(name)) {
            continue;
        }
        if (!LABEL_NAME_RE.test(name)) {
            throw new Error(`Label name must be an ASCII identifier: ${name}`);
        }
        const key = name.toLowerCase();
        if (seen.has(key)) {
            throw new Error(`Label name must be unique: ${name}`);
        }
        seen.add(key);
        const typeRaw = String((item as any).type || 'any').toLowerCase();
        const type = LABEL_TYPES.has(typeRaw) ? typeRaw as LabelSpec['type'] : 'any';
        const color = typeof (item as any).color === 'string' ? String((item as any).color).trim() : undefined;
        const description = typeof (item as any).description === 'string' ? String((item as any).description) : '';
        const attributes = Array.isArray((item as any).attributes) ? (item as any).attributes : [];
        out.push({
            name,
            type,
            description,
            ...(color ? { color } : {}),
            attributes,
        });
    }
    if (!out.length) {
        throw new Error('No usable labels in JSON (placeholder names like None are skipped)');
    }
    return out;
}

