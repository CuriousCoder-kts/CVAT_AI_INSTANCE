export function findPreset(id: string | null | undefined): PresetBundle | undefined {
    if (!id || typeof id !== 'string') return undefined;
    const exact = PRESET_BUNDLES.find((p) => p.id === id);
    if (exact) return exact;
    const aliasKey = PRESET_ID_ALIASES[id];
    if (aliasKey) return PRESET_BUNDLES.find((p) => p.id === aliasKey) || undefined;
    const normalized = id.trim().toLowerCase();
    for (const p of PRESET_BUNDLES) {
        if (p.id.toLowerCase() === normalized) return p;
        if (p.name.trim().toLowerCase() === normalized) return p;
    }
    for (const [fromAlias, toId] of Object.entries(PRESET_ID_ALIASES)) {
        if (fromAlias.toLowerCase() === normalized) {
            return PRESET_BUNDLES.find((p) => p.id === toId) || undefined;
        }
    }
    return undefined;
}
export function resolvePresetIdCanonical(id: string | null | undefined): string | undefined {
    const p = findPreset(id);
    return p ? p.id : (typeof id === 'string' && id.trim() ? id.trim() : undefined);
}
