        output_parser_config?: Record<string, any>;
        labels?: LabelSpec[];
        caption_attribute_name?: string;
    };
}

const POISON_PROMPT_VALUES = new Set(['undefined', 'string', 'null', 'nan', 'NaN', 'object', '[object Object]', '{}', '***PRESERVED***']);
export function sanitizePromptValue(raw: any): string {
    if (raw === null || raw === undefined) return '';
    if (typeof raw !== 'string') {
        try { return String(raw ?? ''); } catch { return ''; }
    }
    const trimmed = raw.trim();
    if (POISON_PROMPT_VALUES.has(trimmed)) return '';
    if (trimmed.length <= 1 && !trimmed.trim()) return '';
    return raw;
}

