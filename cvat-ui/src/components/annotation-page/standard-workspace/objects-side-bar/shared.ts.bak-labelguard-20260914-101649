import { Attribute, ObjectState, ObjectType } from 'cvat-core-wrapper';
import { ColorBy } from 'reducers';

const DETECTOR_TRACK_ID_NAMES = new Set(['track_id', 'object_id', 'instance_id']);

/** Marker: cvat-hide-shape-track-id */
export const HIDE_SHAPE_TRACK_ID_MARKER = 'cvat-hide-shape-track-id';

export function isDetectorTrackIdAttr(name: string | undefined): boolean {
    return DETECTOR_TRACK_ID_NAMES.has(String(name || '').toLowerCase());
}

/** Hide track_id/object_id/instance_id in DETAILS; header already shows ``tid:``. */
export function visibleObjectAttributes(attributes: Attribute[] | undefined, _objectType?: ObjectType | string): Attribute[] {
    const list = Array.isArray(attributes) ? attributes : [];
    return list.filter((attr) => !isDetectorTrackIdAttr(attr?.name));
}

export function readDetectorTrackId(
    specs: Attribute[] | undefined,
    values: Record<number, string> | undefined,
): string {
    if (!Array.isArray(specs) || !values) {
        return '';
    }
    const spec = specs.find((item) => DETECTOR_TRACK_ID_NAMES.has(String(item?.name || '').toLowerCase()));
    if (!spec || spec.id == null) {
        return '';
    }
    const value = values[spec.id as number];
    if (value == null) {
        return '';
    }
    return String(value).trim();
}

export function getObjectStateColor(state: ObjectState, colorBy: ColorBy): {
    hex: string;
    rgbComponents: () => string;
} {
    let color = '';
    try {
        if (colorBy === ColorBy.INSTANCE) {
            color = state.color;
        } else if (colorBy === ColorBy.GROUP) {
            color = state.group?.color ?? '#000000';
        } else if (colorBy === ColorBy.LABEL) {
            color = state.label.color as string;
        }

        color = color.slice(1);
        if (color.length === 3) {
            color = color.split('').map((ch) => ch + ch).join('');
        }

        if (!/^([0-9a-f]{6})$/i.test(color)) {
            throw new Error('Invalid hex color format');
        }
    } catch (_: unknown) {
        // fallback
        color = 'ffffff';
    }

    const convert = (start: number, stop: number): string => (
        `${parseInt(color.slice(start, stop), 16)}`
    );

    return {
        hex: `#${color}`,
        rgbComponents() {
            return `${convert(0, 2)}, ${convert(2, 4)}, ${convert(4, 6)}`;
        },
    };
}
